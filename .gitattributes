# 默认：由 Git 自动判定，仓库内统一 LF（避免 Windows 提交产生整文件 diff）
* text=auto eol=lf

# 明确按文本处理并强制 LF
*.kt    text eol=lf
*.kts   text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.pro   text eol=lf
*.gradle text eol=lf
gradlew text eol=lf

# Windows 批处理必须 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行转换
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.zip   binary

# 中文文档在统计中按文本处理
*.md diff=markdown
