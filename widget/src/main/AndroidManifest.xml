<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      小组件声明。注意这是 library 模块的 manifest，会合并进 :app 的最终清单——
      前提是 :app 依赖了 :widget（见 app/build.gradle.kts）。

      exported=true 是必须的：桌面启动器（另一个进程）要向我们发 APPWIDGET_UPDATE 广播。
    -->
    <application>

        <receiver
            android:name=".DueWordWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/due_word_widget_info" />
        </receiver>

        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dancijiyi.widget.action.MARK_REVIEWED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
