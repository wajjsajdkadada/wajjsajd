<?xml version="1.0" encoding="utf-8"?>
<!--
  首页布局（第 17 轮重做）。

  设计意图（对应老师说"太普通"的三点问题）：
  1. 原来只有一行标题 + 一堆系统灰按钮，没有视觉焦点 →
     现在有**渐变头部 + 主 CTA 卡 + 数据卡 + 图标宫格**四层结构，眼睛有落点；
  2. 原来的按钮没有层级（"开始复习"和"清空历史"一样大）→
     现在主操作是整块渐变大卡片，次要入口是 2×2 白卡，调试功能收进底部小字；
  3. 原来没有品牌感 → 统一青绿主色 + 圆角（8/12/20dp）+ 图标，与桌面小组件同色系。

  所有可点区域都用 foreground 水波纹（Android 原生 selectableItemBackground），
  不用自造 selector，保证按压反馈与系统一致。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_alt"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- ============ 顶部渐变头部 ============ -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="28dp">

            <!-- 问候语：按时间段变化，让页面"有温度" -->
            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="早上好"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/text_body" />

            <!-- 今日待复习：整页最大的数字，一眼看到重点 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dueCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginBottom="6dp"
                    android:text="个词待复习"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/text_subtitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="共 0 词 · 0 个词库"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_caption" />

            <!-- 小组件状态胶囊：把伴生模块的存在感放到首页 -->
            <TextView
                android:id="@+id/widgetPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_pill"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="6dp"
                android:text="桌面小组件已同步"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============ 三个统计小卡 ============ -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_m">

                <TextView
                    android:id="@+id/statTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="总词数"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_m">

                <TextView
                    android:id="@+id/statDue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/quality_forgot"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日到期"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_m">

                <TextView
                    android:id="@+id/statBooks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/brand_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="词库数"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 主 CTA：开始复习 ============ -->
        <LinearLayout
            android:id="@+id/ctaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:background="@drawable/bg_card_cta"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_xl">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ctaTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始复习"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/text_headline"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ctaSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="今日 0 词就绪"
                    android:textColor="#D9FFFFFF"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/text_headline" />
        </LinearLayout>

        <!-- ============ 2×2 功能宫格 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_l"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_list" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="单词列表"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navListSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 词"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navImport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_import" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="导入词库"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navImportSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CSV 文件"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_l"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sliders" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="算法参数"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navSettingsSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="每日上限 50"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navReminder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <ImageView
                    android:id="@+id/navReminderIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bell" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="每日提醒"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navReminderSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未开启"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 调试入口：正式功能不放在首页，避免答辩时误点 -->
        <TextView
            android:id="@+id/devEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="@dimen/space_m"
            android:text="开发者选项（调试用）"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
