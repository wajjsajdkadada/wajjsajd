<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      存储权限：**只服务于 API ≤ 32 的「下载目录直读」兼容通道**。
      主导入路径用 SAF（ACTION_OPEN_DOCUMENT），完全不需要该权限；
      maxSdkVersion=32 保证 Android 13+ 不会申请一个已经失效的权限。
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 每日复习提醒（Android 13+ 需要运行时授予；拒绝后降级为「仅桌面小组件提醒」） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+ 的包可见性限制：不声明这段 queries，应用就查不到系统的 TTS 引擎，
      TextToSpeech 会一直初始化失败（表现为「点朗读没声音」）。
      注意：朗读本身**不需要任何权限**，这里只是让系统允许我们绑定 TTS 服务。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".DanCiJiYiApp"
        android:allowBackup="true"
        android:label="单词记忆"
        android:supportsRtl="true"
        android:theme="@style/Theme.DanCiJiYi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="单词记忆">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.imports.ImportActivity"
            android:exported="false"
            android:label="导入词库" />

        <activity
            android:name=".ui.wordlist.WordListActivity"
            android:exported="false"
            android:label="单词列表" />

        <activity
            android:name=".ui.detail.WordDetailActivity"
            android:exported="false"
            android:label="单词详情"
            android:parentActivityName=".ui.wordlist.WordListActivity" />

        <activity
            android:name=".ui.review.ReviewActivity"
            android:exported="false"
            android:label="今日复习" />

        <activity
            android:name=".ui.settings.AlgorithmSettingsActivity"
            android:exported="false"
            android:label="算法参数" />

    </application>

</manifest>
