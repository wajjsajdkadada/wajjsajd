<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      存储权限：**只服务于 API ≤ 32 的「下载目录直读」兼容通道**。
      主导入路径用 SAF（ACTION_OPEN_DOCUMENT），完全不需要该权限；
      maxSdkVersion=32 保证 Android 13+ 不会申请一个已经失效的权限。
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".DanCiJiYiApp"
        android:allowBackup="true"
        android:label="单词记忆"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="单词记忆">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.imports.ImportActivity"
            android:exported="false"
            android:label="导入词库" />

        <activity
            android:name=".ui.wordlist.WordListActivity"
            android:exported="false"
            android:label="单词列表" />

        <activity
            android:name=".ui.detail.WordDetailActivity"
            android:exported="false"
            android:label="单词详情"
            android:parentActivityName=".ui.wordlist.WordListActivity" />

        <activity
            android:name=".ui.review.ReviewActivity"
            android:exported="false"
            android:label="今日复习" />

        <activity
            android:name=".ui.settings.AlgorithmSettingsActivity"
            android:exported="false"
            android:label="算法参数" />

    </application>

</manifest>
