<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".DanCiJiYiApp"
        android:allowBackup="true"
        android:label="单词记忆"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="单词记忆">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.imports.ImportActivity"
            android:exported="false"
            android:label="导入词库" />

        <activity
            android:name=".ui.wordlist.WordListActivity"
            android:exported="false"
            android:label="单词列表" />

        <activity
            android:name=".ui.detail.WordDetailActivity"
            android:exported="false"
            android:label="单词详情"
            android:parentActivityName=".ui.wordlist.WordListActivity" />

        <activity
            android:name=".ui.review.ReviewActivity"
            android:exported="false"
            android:label="今日复习" />

    </application>

</manifest>
